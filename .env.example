# Strategy Lab - environment configuration
# Copy to .env (systemd's EnvironmentFile picks it up automatically, see
# deploy/) and fill in real values. Never commit the real .env file.

# Required in production - signs session cookies for accounts (see auth.py).
# Without it, a random key is generated per process and every restart
# silently logs every user out. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "true" only once the app is actually served over HTTPS (e.g. behind
# the nginx reverse proxy in deploy/) - makes the session cookie HTTPS-only.
# Leave empty for local plain-HTTP development, otherwise login will appear
# to silently fail (the browser drops a Secure cookie sent over http://).
FORCE_HTTPS_COOKIES=

# Max number of heavy operations (backtest/optimize/portfolio build & run &
# backtest/market-data sync) allowed to run at once, per gunicorn worker
# process - protects the free public server from accidental overload.
MAX_CONCURRENT_HEAVY_JOBS=3

# Binance Spot public market-data endpoints. No API key needed or accepted -
# these are public, unauthenticated REST/WebSocket endpoints. Override only
# for testing/mocking or a regional mirror.
BINANCE_REST_BASE=https://data-api.binance.vision
BINANCE_WS_BASE=wss://data-stream.binance.vision:443

# Optional: where the bounded Binance candle cache lives. Defaults to
# ./cache/market-data next to app.py; set this to point it at a larger disk.
MARKET_CACHE_PATH=

# Optional: log file directory. Defaults to ./logs. STRATEGY_LAB_LOGS_DIR is
# the current name; MOEX_LAB_LOGS_DIR still works as a fallback for an
# existing production deployment that hasn't renamed its env var yet.
STRATEGY_LAB_LOGS_DIR=
MOEX_LAB_LOGS_DIR=

# Optional: candle cache eviction tuning - safe to leave unset.
MARKET_CACHE_MAX_GB=
MARKET_CACHE_TTL_DAYS=

# Optional: realtime market-data indicator tuning. Binance Spot trades 24/7 -
# there is no "market closed" concept and no fixed source-delay baseline
# (unlike the old MOEX free-tier feed) - these just tune how stale a REST
# snapshot has to be before the UI stops calling it "live".
REALTIME_ENABLED=
REALTIME_STALE_AFTER_MS=
REALTIME_DISCONNECTED_AFTER_MS=

# Persistent price-alert evaluator. One gunicorn process becomes leader via a
# file lock, so this remains single-delivery even with multiple web workers.
ALERT_WORKER_ENABLED=true
ALERT_POLL_INTERVAL_SECONDS=45

# Standards-based Web Push (Safari/macOS, Chrome/Android, and iOS/iPadOS Home
# Screen web apps). Generate a VAPID key pair during deployment; private key
# stays server-side, public key is deliberately exposed to subscribed clients.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@generationweb.ru

# Optional Telegram delivery. Create a bot with @BotFather, set its username
# without @, and configure Telegram webhook to:
# https://strategylab.generationweb.ru/api/notifications/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional email delivery. If SMTP_HOST/SMTP_FROM are empty, the Email channel
# is shown as unavailable and no credentials are required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# One-time payments. Leave BILLING_PROVIDER=mock in local/dev environments.
# Production must use yookassa and real credentials supplied outside git.
BILLING_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://strategylab.generationweb.ru/account/payments/result
